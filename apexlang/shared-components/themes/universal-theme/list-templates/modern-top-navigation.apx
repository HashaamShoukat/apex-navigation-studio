listTemplate modern-top-navigation (
    name: Modern Top Navigation
    templateClass: pullDownMenu
    templateOptions {
        default: [
            js-tabLike
        ]
    }
    list {
        beforeEntries: <link rel="stylesheet" href="#APP_FILES#navigation-studio/top-nav.css"><div class="t-Header-nav-list #COMPONENT_CSS_CLASSES#" id="t_MenuNav"><ul>
        afterEntries:
            ```html
            </ul></div>
            <script #APEX_CSP_NONCE_ATTRIBUTE#>
            /* Modern Top Navigation: source in Navigation Studio _src/top-nav-pre.js */
            (()=>{const s=document.getElementById("t_MenuNav"),t=document.body,e=/^(ns-(?!Bar-)|js-(tabLike|menu-callout|showSubMenuIcons))/,n=()=>{const n=/[#&]ns=([^&]*)/.exec(location.hash);n&&([...s.classList].forEach((t=>e.test(t)&&s.classList.remove(t))),decodeURIComponent(n[1]).split(/[\s,+]+/).forEach((t=>e.test(t)&&s.classList.add(t))),[...t.classList].forEach((s=>/^ns-(?!Bar-|TopNav$)/.test(s)&&t.classList.remove(s)))),t.classList.add("ns-TopNav"),s.classList.forEach((s=>s.startsWith("ns-")&&t.classList.add(s)))};n(),window.addEventListener("hashchange",n),window.nsTopBadges=[...s.querySelectorAll(":scope > ul > li > a")].map((s=>{const t=/\s*\[(.*?)\]\s*$/.exec(s.textContent);return t&&(s.textContent=s.textContent.slice(0,t.index)),t?t[1]:""}))})();
            </script>
            ```
    }
    entry {
        current: <li class="a-MenuBar-item a-Menu--current" data-current="true" data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a class="a-MenuBar-label" href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a></li>
        currentWithSublist: <li class="a-MenuBar-item a-Menu--current" data-current="true" data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a class="a-MenuBar-label" href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
        noncurrent: <li class="a-MenuBar-item" data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a class="a-MenuBar-label" href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a></li>
        noncurrentWithSublist: <li class="a-MenuBar-item" data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a class="a-MenuBar-label" href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
    }
    sublist {
        beforeEntries: <ul class="u-DisplayNone">
        afterEntries: </ul></li>
    }
    sublistEntry {
        current: <li data-current="true" data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a></li>
        currentWithSublist: <li data-current="true" data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
        noncurrent: <li data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a></li>
        noncurrentWithSublist: <li data-id="#A01#" data-disabled="#A02#" data-hide="#A03#" data-shortcut="#A05#" data-icon="#ICON_CSS_CLASSES#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // Modern Top Navigation: source in Navigation Studio _src/top-nav.js
            !function(e){const a=e("#t_MenuNav",apex.gPageContext$);a.hasClass("js-addActions")&&apex.actions.addFromMarkup(a),a.menu({behaveLikeTabs:a.hasClass("js-tabLike"),menubarShowSubMenuIcon:a.hasClass("js-showSubMenuIcons")||null,menubar:!0,menubarOverflow:!0,callout:a.hasClass("js-menu-callout")});const n=()=>a.find(".a-MenuBar-item").not(".a-MenuBar-item--overflow").each((function(a){const n=(window.nsTopBadges||[])[a],s=e(this).children(".a-MenuBar-label");n&&!s.children(".ns-TopBadge").length&&s.append(e('<span class="ns-TopBadge"></span>').text(n))}));n(),a.menu("resize"),n(),e(window).on("apexwindowresized",(()=>setTimeout(n,0)))}(apex.jQuery);
            ```
    }
    attributeDescriptions {
        a01: Menu Item ID / Action Name
        a02: Disabled (True/False)
        a03: Hidden (True/False)
        a04: Title Attribute (Used By Actions Only)
        a05: Shortcut Key
        a06: Link Target
        a10: OpenTelemetry Label
    }
    comments {
        comments: Modern Top Navigation (Navigation Studio) - a copy of Universal Theme's Top Navigation Menu (same markup, id t_MenuNav and menu widget) with designs as template options: Design, Accent Color, Color Scheme, Header. "Label [5]" shows a badge on top-level entries.
    }

    templateOption top-pills (
        name: Pills
        group: @list/ns-top-design
        sequence: 10
        appearance {
            cssClasses: ns-Top--pills
        }
    )

    templateOption top-segmented (
        name: Segmented
        group: @list/ns-top-design
        sequence: 20
        appearance {
            cssClasses: ns-Top--segmented
        }
    )

    templateOption top-midnight (
        name: Midnight
        group: @list/ns-top-design
        sequence: 30
        appearance {
            cssClasses: ns-Top--midnight
        }
    )

    templateOption top-gradient (
        name: Gradient
        group: @list/ns-top-design
        sequence: 40
        appearance {
            cssClasses: ns-Top--gradient
        }
    )

    templateOption top-glass (
        name: Glass
        group: @list/ns-top-design
        sequence: 50
        appearance {
            cssClasses: ns-Top--glass
        }
    )

    templateOption accent-ocean (
        name: Ocean
        group: @list/ns-top-accent
        sequence: 10
        appearance {
            cssClasses: ns-Accent--ocean
        }
    )

    templateOption accent-indigo (
        name: Indigo
        group: @list/ns-top-accent
        sequence: 20
        appearance {
            cssClasses: ns-Accent--indigo
        }
    )

    templateOption accent-violet (
        name: Violet
        group: @list/ns-top-accent
        sequence: 30
        appearance {
            cssClasses: ns-Accent--violet
        }
    )

    templateOption accent-emerald (
        name: Emerald
        group: @list/ns-top-accent
        sequence: 40
        appearance {
            cssClasses: ns-Accent--emerald
        }
    )

    templateOption accent-rose (
        name: Rose
        group: @list/ns-top-accent
        sequence: 50
        appearance {
            cssClasses: ns-Accent--rose
        }
    )

    templateOption accent-amber (
        name: Amber
        group: @list/ns-top-accent
        sequence: 60
        appearance {
            cssClasses: ns-Accent--amber
        }
    )

    templateOption accent-slate (
        name: Slate
        group: @list/ns-top-accent
        sequence: 70
        appearance {
            cssClasses: ns-Accent--slate
        }
    )

    templateOption accent-wine (
        name: Wine
        group: @list/ns-top-accent
        sequence: 80
        appearance {
            cssClasses: ns-Accent--wine
        }
    )

    templateOption accent-tangerine (
        name: Tangerine
        group: @list/ns-top-accent
        sequence: 90
        appearance {
            cssClasses: ns-Accent--tangerine
        }
    )

    templateOption accent-cyan (
        name: Cyan
        group: @list/ns-top-accent
        sequence: 100
        appearance {
            cssClasses: ns-Accent--cyan
        }
    )

    templateOption scheme-dark (
        name: Dark
        group: @list/ns-top-scheme
        sequence: 10
        appearance {
            cssClasses: ns-Scheme--dark
        }
    )

    templateOption scheme-auto (
        name: Follow Device Setting
        group: @list/ns-top-scheme
        sequence: 20
        appearance {
            cssClasses: ns-Scheme--auto
        }
    )

    templateOption header-theme (
        name: Keep Theme Header
        group: @list/ns-top-header
        sequence: 10
        appearance {
            cssClasses: ns-Header--theme
        }
    )

    templateOption tab-like (
        name: Behave Like Tabs
        sequence: 100
        appearance {
            cssClasses: js-tabLike
        }
        help {
            helpText: Entries with sub-menus go to their page when clicked; the arrow opens the sub-menu.
        }
    )

    templateOption show-sub-menu-icons (
        name: Show Sub Menu Icons
        sequence: 110
        appearance {
            cssClasses: js-showSubMenuIcons
        }
        help {
            helpText: Show icons in the drop-down menus.
        }
    )

    templateOption menu-callout (
        name: Display Menu Callout
        sequence: 120
        appearance {
            cssClasses: js-menu-callout
        }
        help {
            helpText: Display a callout arrow on the drop-down menus.
        }
    )

    templateOption logo-none (
        name: Hide Logo Mark
        sequence: 130
        appearance {
            cssClasses: ns-Logo--none
        }
        help {
            helpText: The design draws a small mark before the application name; this hides it.
        }
    )

    templateOption add-actions (
        name: Add Actions
        sequence: 140
        appearance {
            cssClasses: js-addActions
        }
        help {
            helpText: Add shortcuts for menu entries (attribute 5). actions.js must be on the page.
        }
    )

)
