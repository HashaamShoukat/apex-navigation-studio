listTemplate modern-top-navigation (
    name: Modern Top Navigation
    templateClass: pullDownMenu
    templateOptions {
        default: [
            js-tabLike
        ]
    }
    list {
        beforeEntries: <div class="t-Header-nav-list #COMPONENT_CSS_CLASSES#" id="t_MenuNav"><ul>
        afterEntries:
            ```html
            </ul></div>
