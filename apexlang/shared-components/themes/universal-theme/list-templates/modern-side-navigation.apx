    }
    attributeDescriptions {
        a01: ID Attribute
        a02: Disabled (True/False)
        a03: Section Heading
        a04: Title Attribute (Used By Actions Only)
        a05: Shortcut Key
        a06: Link Target
        a10: OpenTelemetry Label
    }
    comments {
        comments: Modern Side Navigation (Navigation Studio) - a copy of Universal Theme's Side Navigation Menu with designs as template options: Design, Accent Color, Color Scheme, Header, Density, Badges, Width. Same markup and ids (t_TreeNav), so theme42.js and the keyboard work as in Universal Theme. List entry attribute 3 = a section heading above the entry; "Label [5]" shows a badge. Options: menu search (Ctrl+K), tooltips on the collapsed rail, a phone bottom bar. Optional text messages: MODERN_NAV.SEARCH, MODERN_NAV.NO_MATCH, MODERN_NAV.MENU, MODERN_NAV.QUICK_LINKS.
    }

    templateOption design-inset (
        name: Inset
        group: @list/ns-design
        sequence: 10
        appearance {
            cssClasses: ns-Design--inset
        }
    )

    templateOption design-floating (
        name: Floating
        group: @list/ns-design
        sequence: 20
        appearance {
            cssClasses: ns-Design--floating
        }
    )

    templateOption design-midnight (
        name: Midnight
        group: @list/ns-design
        sequence: 30
        appearance {
            cssClasses: ns-Design--midnight
        }
    )

    templateOption design-rail (
        name: Rail
        group: @list/ns-design
