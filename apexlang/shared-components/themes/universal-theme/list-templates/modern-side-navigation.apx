        }
    )

    templateOption scheme-dark (
        name: Dark
        group: @list/ns-scheme
        sequence: 10
        appearance {
            cssClasses: ns-Scheme--dark
        }
    )

    templateOption scheme-auto (
        name: Follow Device Setting
        group: @list/ns-scheme
        sequence: 20
        appearance {
            cssClasses: ns-Scheme--auto
        }
    )

    templateOption nav-collapsed-default (
        name: Icons
        group: @list/ns-collapse
        sequence: 10
        appearance {
            cssClasses: js-navCollapsed--default
        }
    )

    templateOption nav-collapsed-hidden (
        name: Hidden
        group: @list/ns-collapse
        sequence: 20
        appearance {
            cssClasses: js-navCollapsed--hidden
        }
    )

    templateOption header-theme (
        name: Keep Theme Header
        group: @list/ns-header
        sequence: 10
        appearance {
            cssClasses: ns-Header--theme
        }
    )

