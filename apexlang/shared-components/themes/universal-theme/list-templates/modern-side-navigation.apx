        name: Soft
        group: @list/ns-badge
        sequence: 10
        appearance {
            cssClasses: ns-Badge--soft
        }
    )

    templateOption badge-red (
        name: Red
        group: @list/ns-badge
        sequence: 20
        appearance {
            cssClasses: ns-Badge--red
        }
    )

    templateOption badge-dot (
        name: Dot
        group: @list/ns-badge
        sequence: 30
        appearance {
            cssClasses: ns-Badge--dot
        }
    )

    templateOption width-narrow (
        name: Narrow
        group: @list/ns-width
        sequence: 10
        appearance {
            cssClasses: ns-Width--narrow
        }
        advanced {
            isAdvancedOption: true
        }
    )

    templateOption width-wide (
        name: Wide
        group: @list/ns-width
        sequence: 20
        appearance {
            cssClasses: ns-Width--wide
        }
        advanced {
            isAdvancedOption: true
        }
    )

    templateOption default-collapsed (
        name: Collapsed by Default
        sequence: 100
        appearance {
            cssClasses: js-defaultCollapsed
        }
        help {
            helpText: Load the menu collapsed. Users can still open it; their choice is remembered for the session.
        }
    )

    templateOption fx-search (
        name: Menu Search
        sequence: 110
        appearance {
            cssClasses: ns-Fx--search
        }
        help {
            helpText: A search field above the menu that finds every entry, sub-levels too. Ctrl+K (Cmd+K) or / opens it.
        }
    )

    templateOption fx-tips (
        name: Tooltips When Collapsed
        sequence: 120
        appearance {
            cssClasses: ns-Fx--tips
        }
        help {
            helpText: Show the entry's name next to the icon when the menu is collapsed.
        }
    )

    templateOption fx-tabbar (
        name: Phone Bottom Bar
        sequence: 130
        appearance {
            cssClasses: ns-Fx--tabbar
        }
        help {
            helpText: On phones: the first four entries and a Menu button in a bar at the bottom of the screen.
        }
    )

    templateOption logo-none (
        name: Hide Logo Mark
        sequence: 140
        appearance {
            cssClasses: ns-Logo--none
        }
        help {
            helpText: The design draws a small mark before the application name; this hides it.
        }
    )

    templateOption hide-default-icon (
        name: Hide Default Item Icon
        sequence: 150
        appearance {
            cssClasses: js-hideDefaultIcon
        }
        help {
            helpText: Hide the default icon of entries without an icon when the menu is expanded.
        }
    )

    templateOption add-actions (
        name: Add Actions
        sequence: 160
        appearance {
            cssClasses: js-addActions
        }
        help {
            helpText: Add shortcuts for menu entries (attribute 5). actions.js must be on the page.
        }
    )

)
