    }
    css {
        inline:
            ```css
            .ns-Nav { --ns-a: var(--ut-palette-primary, #4f46e5); --ns-a2: var(--ns-a); --ns-on: var(--ut-palette-primary-contrast, #fff); --ns-ink: color-mix(in srgb, var(--ns-a) 72%, #000); --ns-tint: color-mix(in srgb, var(--ns-a) 45%, #fff); }
            .ns-Accent--ocean { --ns-a: #0369a1; --ns-a2: #0e7490; --ns-on: #fff; --ns-ink: #075985; --ns-tint: #7dd3fc; }
            .ns-Accent--indigo { --ns-a: #4f46e5; --ns-a2: #6d28d9; --ns-on: #fff; --ns-ink: #4338ca; --ns-tint: #a5b4fc; }
            .ns-Accent--violet { --ns-a: #7c3aed; --ns-a2: #a21caf; --ns-on: #fff; --ns-ink: #6d28d9; --ns-tint: #c4b5fd; }
            .ns-Accent--emerald { --ns-a: #047857; --ns-a2: #0f766e; --ns-on: #fff; --ns-ink: #047857; --ns-tint: #6ee7b7; }
            .ns-Accent--rose { --ns-a: #e11d48; --ns-a2: #be185d; --ns-on: #fff; --ns-ink: #be123c; --ns-tint: #fda4af; }
            .ns-Accent--amber { --ns-a: #f59e0b; --ns-a2: #f97316; --ns-on: #1c1303; --ns-ink: #92400e; --ns-tint: #fcd34d; }
            .ns-Accent--slate { --ns-a: #475569; --ns-a2: #1e293b; --ns-on: #fff; --ns-ink: #334155; --ns-tint: #cbd5e1; }
            .ns-Accent--wine { --ns-a: #9f1239; --ns-a2: #6b21a8; --ns-on: #fff; --ns-ink: #881337; --ns-tint: #f9a8d4; }
            .ns-Accent--tangerine { --ns-a: #c2410c; --ns-a2: #b91c1c; --ns-on: #fff; --ns-ink: #9a3412; --ns-tint: #fdba74; }
            .ns-Accent--cyan { --ns-a: #0e7490; --ns-a2: #1d4ed8; --ns-on: #fff; --ns-ink: #155e75; --ns-tint: #67e8f9; }
            .ns-Nav {
            --ns-bg: light-dark(#fbfbfc, #15171c); --ns-fg: light-dark(#1f2328, #eceef2); --ns-muted: light-dark(#5b6170, #a3a9b6);
            --ns-hover: light-dark(rgb(15 23 42 / .055), rgb(255 255 255 / .07)); --ns-line: light-dark(#e6e8ec, #2a2e36);
            --ns-act-bg: light-dark(color-mix(in srgb, var(--ns-a) 11%, #fff), color-mix(in srgb, var(--ns-a) 26%, #15171c));
            --ns-act-fg: light-dark(var(--ns-ink), #fff); --ns-act-icon: light-dark(var(--ns-a), var(--ns-tint));
            --ns-parent: light-dark(var(--ns-ink), var(--ns-tint)); --ns-sec: light-dark(#596070, #9aa0ae);
            --ns-badge-bg: var(--ns-a); --ns-badge-fg: var(--ns-on); --ns-focus: light-dark(var(--ns-a), var(--ns-tint));
            --ns-hdr-bg: var(--ns-bg); --ns-hdr-fg: var(--ns-fg); --ns-hdr-line: var(--ns-line); --ns-hb-bg: var(--ns-a); --ns-hb-fg: var(--ns-on);
            --ns-r: .5rem; --ns-gap: .5rem; --ns-py: .5rem; --ns-fs: .875rem; --ns-icon: 1rem; --ns-rail: 3.75rem; --ns-bar: none;
            --ut-nav-width: 15.5rem; --ut-nav-collapsed-icon-width: var(--ns-rail);
            }
            .ns-Nav .t-Body-nav, .ns-Nav .t-Header, .ns-Nav .ns-TabBar, .ns-Tip { color-scheme: light; }
            .ns-Scheme--dark .t-Body-nav, .ns-Scheme--dark .t-Header, .ns-Scheme--dark .ns-TabBar, .ns-Scheme--dark .ns-Tip { color-scheme: dark; }
            .ns-Scheme--auto .t-Body-nav, .ns-Scheme--auto .t-Header, .ns-Scheme--auto .ns-TabBar, .ns-Scheme--auto .ns-Tip { color-scheme: light dark; }
            .ns-Density--compact { --ns-py: .3125rem; --ns-fs: .8125rem; --ns-gap: .375rem; }
            .ns-Density--spacious { --ns-py: .6875rem; --ns-fs: .9375rem; --ns-gap: .625rem; }
            .ns-Width--narrow { --ut-nav-width: 13.5rem; }
            .ns-Width--wide { --ut-nav-width: 18rem; }
            .ns-Nav .t-Body-nav { background: var(--ns-bg); color: var(--ns-fg); box-shadow: inset calc(var(--ns-edge, 1) * -1px) 0 0 var(--ns-line); }
            .ns-Nav.u-RTL .t-Body-nav, .u-RTL .ns-Nav .t-Body-nav { box-shadow: inset calc(var(--ns-edge, 1) * 1px) 0 0 var(--ns-line); }
            .ns-Nav .t-Body-nav::after { display: none; }
            .ns-Nav .t-TreeNav { --a-treeview-node-padding-y: var(--ns-py); --a-treeview-node-padding-x: .625rem; --a-treeview-node-font-size: var(--ns-fs);
            --ut-treeview-icon-size: var(--ns-icon); --ut-treeview-toplevel-node-font-size: var(--ns-fs); --a-treeview-node-text-color: var(--ns-muted);
            padding-block: .5rem; font-size: var(--ns-fs); }
            .ns-Nav .t-TreeNav .a-TreeView-node { border: 0; margin: 0; }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel + .a-TreeView-node--topLevel { margin-block-start: 2px; }
            .ns-Nav .t-TreeNav .a-TreeView-row { width: auto; margin-inline: var(--ns-gap); border-radius: var(--ns-r); background: transparent !important; box-shadow: none !important; transition: background-color .15s ease, box-shadow .15s ease; }
            .ns-Nav .t-TreeNav .a-TreeView-row::before { display: none; }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel ul { background: transparent !important; }
            .ns-Nav .t-TreeNav .a-TreeView-content, .ns-Nav .t-TreeNav .a-TreeView-toggle { color: var(--ns-muted) !important; }
            .ns-Nav .t-TreeNav .a-TreeView-content { margin-inline: var(--ns-gap); }
            .ns-Nav .t-TreeNav .a-TreeView-label { color: inherit; font-weight: 450; letter-spacing: -.005em; }
            .ns-Nav .t-TreeNav .a-TreeView-content .fa { color: inherit; opacity: .9; }
            .ns-Nav .t-TreeNav .a-TreeView-row.is-hover { background: var(--ns-hover) !important; }
            .ns-Nav .t-TreeNav .a-TreeView-row.is-hover ~ .a-TreeView-content, .ns-Nav .t-TreeNav .a-TreeView-row.is-hover ~ .a-TreeView-toggle { color: var(--ns-fg) !important; }
            .ns-Nav .t-TreeNav .a-TreeView-row.is-selected { background: var(--ns-act-bg) !important; box-shadow: var(--ns-bar) !important; }
            .ns-Nav .t-TreeNav .a-TreeView-row.is-selected ~ .a-TreeView-content, .ns-Nav .t-TreeNav .a-TreeView-row.is-selected ~ .a-TreeView-toggle { color: var(--ns-act-fg) !important; }
            .ns-Nav .t-TreeNav .a-TreeView-content.is-selected .a-TreeView-label { font-weight: 600; }
            .ns-Nav .t-TreeNav .a-TreeView-content.is-selected .fa { color: var(--ns-act-icon); opacity: 1; }
            .ns-Nav .t-TreeNav .a-TreeView-content.is-current--top:not(.is-selected) { color: var(--ns-parent) !important; }
            .ns-Nav .t-TreeNav .a-TreeView-content.is-current--top .a-TreeView-label { font-weight: 600; }
            .ns-Nav .t-TreeNav .a-TreeView-row.is-focused { outline: 2px solid var(--ns-focus) !important; outline-offset: -2px; }
            .ns-Nav .t-TreeNav .a-TreeView-label:focus { outline: none; }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel > ul { padding-block: 2px; --a-treeview-node-padding-y: calc(var(--ns-py) - .125rem); }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel > ul .a-TreeView-content { --a-treeview-node-font-size: calc(var(--ns-fs) - .0625rem); }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel > ul > .a-TreeView-node > .a-TreeView-content { padding-inline-start: calc(var(--ut-treeview-toplevel-icon-container-width, 1.5rem) + .25rem); }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel > ul ul > .a-TreeView-node > .a-TreeView-content { padding-inline-start: calc(var(--ut-treeview-toplevel-icon-container-width, 1.5rem) + 1.25rem); }
            .ns-Nav .t-TreeNav .a-TreeView-toggle { opacity: .7; }
            .ns-Nav .t-TreeNav .a-TreeView-badge { background: var(--ns-badge-bg); color: var(--ns-badge-fg); border-radius: 999px; font-weight: 600; font-size: .6875rem; line-height: 1.125rem; min-width: 1.125rem; padding: 0 .375rem; text-align: center; font-variant-numeric: tabular-nums; }
            .ns-Badge--soft .t-TreeNav .a-TreeView-badge { --ns-badge-bg: light-dark(color-mix(in srgb, var(--ns-a) 14%, #fff), color-mix(in srgb, var(--ns-a) 30%, #000)); --ns-badge-fg: light-dark(var(--ns-ink), var(--ns-tint)); }
            .ns-Badge--red .t-TreeNav .a-TreeView-badge { --ns-badge-bg: #dc2626; --ns-badge-fg: #fff; }
            .ns-Badge--dot .t-TreeNav .a-TreeView-badge { width: .5rem; height: .5rem; min-width: 0; padding: 0; font-size: 0; line-height: 0; overflow: hidden; align-self: center; }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel[data-ns-section] { margin-block-start: 1.75rem; position: relative; }
            .ns-Nav .t-TreeNav .a-TreeView-node--topLevel[data-ns-section]:first-child { margin-block-start: 1.375rem; }
            .ns-Nav .t-TreeNav [data-ns-section]::before { content: attr(data-ns-section); position: absolute; inset-block-end: calc(100% + .3125rem); inset-inline: calc(var(--ns-gap) + .625rem) var(--ns-gap);
            font-size: .6875rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ns-sec); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
