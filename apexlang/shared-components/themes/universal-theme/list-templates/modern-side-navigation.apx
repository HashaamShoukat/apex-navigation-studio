            ```
    }
    entry {
        current:
            ```html
            <li data-current="true" data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#" data-section="#A03#">
              <a href="#LINK#" class="u-DisplayNone" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
              <div class="a-TreeView-node a-TreeView-node--topLevel" aria-hidden="true">
                <div role="none" class="a-TreeView-row"></div>
                <div role="none" class="a-TreeView-content">
                  <span class="fa #ICON_CSS_CLASSES#"></span>
                  <span class="a-TreeView-label">#TEXT_ESC_SC#</span>
                </div>
              </div>
            </li>
            ```
        currentWithSublist:
            ```html
            <li data-current="true" data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#" data-section="#A03#">
              <a href="#LINK#" class="u-DisplayNone" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
              <div class="a-TreeView-node a-TreeView-node--topLevel" aria-hidden="true">
                <div role="none" class="a-TreeView-row"></div>
                <div role="none" class="a-TreeView-content">
                  <span class="fa #ICON_CSS_CLASSES#"></span>
                  <span class="a-TreeView-label">#TEXT_ESC_SC#</span>
                </div>
              </div>
            ```
        noncurrent:
            ```html
            <li data-current="false" data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#" data-section="#A03#">
              <a href="#LINK#" class="u-DisplayNone" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
              <div class="a-TreeView-node a-TreeView-node--topLevel" aria-hidden="true">
                <div role="none" class="a-TreeView-row"></div>
                <div role="none" class="a-TreeView-content">
                  <span class="fa #ICON_CSS_CLASSES#"></span>
                  <span class="a-TreeView-label">#TEXT_ESC_SC#</span>
                </div>
              </div>
            </li>
            ```
        noncurrentWithSublist:
            ```html
            <li data-current="false" data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#" data-section="#A03#">
              <a href="#LINK#" class="u-DisplayNone" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
              <div class="a-TreeView-node a-TreeView-node--topLevel" aria-hidden="true">
                <div role="none" class="a-TreeView-row"></div>
                <div role="none" class="a-TreeView-content">
                  <span class="fa #ICON_CSS_CLASSES#"></span>
                  <span class="a-TreeView-label">#TEXT_ESC_SC#</span>
                </div>
              </div>
            ```
    }
    sublist {
        beforeEntries: <ul class="u-DisplayNone">
        afterEntries: </ul></li>
    }
    sublistEntry {
        current: <li data-current="true" data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a></li>
        currentWithSublist: <li data-current="true" data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
        noncurrent: <li data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a></li>
        noncurrentWithSublist: <li data-id="#A01#" data-disabled="#A02#" data-icon="#ICON_CSS_CLASSES#" data-shortcut="#A05#"><a href="#LINK#" title="#A04#" target="#A06#" data-otel-label="#A10#" #LINK_ATTR#>#TEXT_ESC_SC#</a>
    }
    javaScript {
        fileUrls: #APEX_FILES#libraries/apex/#MIN_DIRECTORY#widget.treeView#MIN#.js?v=#APEX_VERSION#
        executeWhenPageLoads:
