list navigation-bar (
    name: Navigation Bar

    entry github (
        label: GitHub
        icon {
            imageIconCssClasses: fa-github
        }
        layout {
            sequence: 10
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_PAGE_ID < 10
        }
        link {
            target: {
                type: url
                url: https://github.com/HashaamShoukat/apex-navigation-studio
            }
        }
    )

    entry nb-notifications (
        label: Notifications
        icon {
            imageIconCssClasses: fa-bell-o
        }
        layout {
            sequence: 20
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_PAGE_ID >= 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            1: 4
        }
    )

    entry nb-help (
        label: Help
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 30
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_PAGE_ID >= 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry nb-user (
        label: Sam Taylor
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 40
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :APP_PAGE_ID >= 10
        }
        link {
            target: {
                page: 10
            }
        }
        userDefinedAttributes {
            2: ns-User
        }
    )

    entry nb-profile (
        label: Profile
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
            parentEntry: @nb-user
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry nb-settings (
        label: Settings
        icon {
            imageIconCssClasses: fa-gear
        }
        layout {
            sequence: 20
            parentEntry: @nb-user
        }
        link {
            target: {
                type: url
                url: #
            }
        }
    )

    entry nb-signout (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @nb-user
        }
        link {
            target: {
                page: 1
            }
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Gallery
        icon {
            imageIconCssClasses: fa-th-large
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
        userDefinedAttributes {
            3: Navigation Studio
        }
    )

    entry designer (
        label: Designer
        icon {
            imageIconCssClasses: fa-paint-brush
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry how-to-use (
        label: How to Use
        icon {
            imageIconCssClasses: fa-book
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 3
            }
        }
    )

    entry demo-side (
        label: Side Menu Demo
        icon {
            imageIconCssClasses: fa-columns
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 10
            }
        }
        userDefinedAttributes {
            3: Demos
        }
    )

    entry demo-top (
        label: Top Menu Demo
        icon {
            imageIconCssClasses: fa-window-maximize
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 19
            }
        }
    )

)

list demo-menu (
    name: Demo Menu

    entry dashboard (
        label: Dashboard
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: expression
            plsqlExpression: :APP_PAGE_ID = 10 and (:REQUEST is null or :REQUEST not in ('ACTIVE','ARCHIVED','TEMPLATES','INVOICES','PRODUCTS','SALES','FINANCE','TEAM','WEEKLY','MONTHLY','ANALYTICS','FILES','INTEGRATIONS','PROFILE','SECURITY','BILLING','HELP'))
        }
        link {
            target: {
                page: 10
            }
        }
        userDefinedAttributes {
            3: Workspace
        }
    )

    entry inbox (
        label: Inbox [12]
        icon {
            imageIconCssClasses: fa-inbox
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: expression
            plsqlExpression: :APP_PAGE_ID = 11 and (:REQUEST is null or :REQUEST not in ('ACTIVE','ARCHIVED','TEMPLATES','INVOICES','PRODUCTS','SALES','FINANCE','TEAM','WEEKLY','MONTHLY','ANALYTICS','FILES','INTEGRATIONS','PROFILE','SECURITY','BILLING','HELP'))
