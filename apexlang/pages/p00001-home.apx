page 1 (
    name: Gallery
    alias: HOME
    title: Navigation Studio - Gallery
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Ready-made looks of the Navigation Studio templates; thumbnails are app files gallery/<id>.jpg (made from the demo page).
            var NS_PRESETS = [{"id":"clean-indigo","name":"Clean","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Accent--indigo","bar":"ns-Bar--avatar"},
                {"id":"inset-violet","name":"Inset","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--inset ns-Accent--violet","bar":"ns-Bar--avatar ns-Bar--segmented"},
                {"id":"floating-ocean","name":"Floating","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--floating ns-Accent--ocean","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"midnight-violet","name":"Midnight","tags":"side dark","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--midnight ns-Accent--violet","bar":"ns-Bar--avatar ns-Bar--icons"},
                {"id":"rail-emerald","name":"Rail","tags":"side light collapsed","pos":"side","state":"collapsed","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--rail ns-Accent--emerald","bar":"ns-Bar--avatar ns-Bar--icons"},
                {"id":"gradient-indigo","name":"Gradient","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--gradient ns-Accent--indigo","bar":"ns-Bar--avatar"},
                {"id":"glass-violet","name":"Glass","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--glass ns-Accent--violet","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"soft-indigo","name":"Soft UI","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--soft ns-Accent--indigo","bar":"ns-Bar--avatar"},
                {"id":"bold-amber","name":"Bold","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--bold ns-Accent--amber","bar":"ns-Bar--avatar ns-Bar--outline ns-Bar--badgeRed"},
                {"id":"outline-emerald","name":"Outline","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--outline ns-Accent--emerald ns-Density--compact","bar":"ns-Bar--avatar"},
                {"id":"editorial","name":"Editorial","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--editorial","bar":"ns-Bar--avatar ns-Bar--icons"},
                {"id":"terminal","name":"Terminal","tags":"side dark","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--terminal","bar":"ns-Bar--avatar ns-Bar--badgeDot"},
                {"id":"clean-dark-cyan","name":"Clean - Dark","tags":"side dark","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Accent--cyan ns-Scheme--dark","bar":"ns-Bar--avatar"},
                {"id":"midnight-rose-collapsed","name":"Midnight - Collapsed","tags":"side dark collapsed","pos":"side","state":"collapsed","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--midnight ns-Accent--rose","bar":"ns-Bar--avatar ns-Bar--icons ns-Bar--pulse"},
                {"id":"inset-dark-emerald","name":"Inset - Dark","tags":"side dark","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--inset ns-Accent--emerald ns-Scheme--dark","bar":"ns-Bar--avatar ns-Bar--segmented"},
                {"id":"gradient-tangerine","name":"Gradient - Tangerine","tags":"side light","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--gradient ns-Accent--tangerine","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"floating-dark-violet","name":"Floating - Dark, Compact","tags":"side dark","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--floating ns-Accent--violet ns-Scheme--dark ns-Density--compact","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"glass-ocean-collapsed","name":"Glass - Collapsed","tags":"side light collapsed","pos":"side","state":"collapsed","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--glass ns-Accent--ocean","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"floating-flyout","name":"Floating - Flyout","tags":"side light flyout","pos":"side","state":"expanded","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--floating ns-Accent--indigo ns-Sub--flyout","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"midnight-flyout","name":"Midnight - Flyout","tags":"side dark collapsed flyout","pos":"side","state":"collapsed","nav":"js-navCollapsed--default ns-Fx--tips ns-Fx--search ns-Fx--tabbar ns-Design--midnight ns-Accent--cyan ns-Sub--flyout","bar":"ns-Bar--avatar ns-Bar--icons"},
                {"id":"top-underline-indigo","name":"Top - Underline","tags":"top light","pos":"top","state":"expanded","nav":"js-tabLike ns-Accent--indigo","bar":"ns-Bar--avatar"},
                {"id":"top-pills-rose","name":"Top - Pills","tags":"top light","pos":"top","state":"expanded","nav":"js-tabLike ns-Top--pills ns-Accent--rose","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"top-segmented-emerald","name":"Top - Segmented","tags":"top light","pos":"top","state":"expanded","nav":"js-tabLike ns-Top--segmented ns-Accent--emerald","bar":"ns-Bar--avatar ns-Bar--icons"},
                {"id":"top-midnight-violet","name":"Top - Midnight","tags":"top dark","pos":"top","state":"expanded","nav":"js-tabLike ns-Top--midnight ns-Accent--violet","bar":"ns-Bar--avatar"},
                {"id":"top-gradient-ocean","name":"Top - Gradient","tags":"top light","pos":"top","state":"expanded","nav":"js-tabLike ns-Top--gradient ns-Accent--ocean","bar":"ns-Bar--avatar ns-Bar--pills"},
                {"id":"top-glass-violet","name":"Top - Glass","tags":"top light","pos":"top","state":"expanded","nav":"js-tabLike ns-Top--glass ns-Accent--violet","bar":"ns-Bar--avatar ns-Bar--pills"}];
            ```
        executeWhenPageLoads:
            ```javascript-browser
            (function ($) {
                var box = document.getElementById("nvs-gallery"), files = box.getAttribute("data-files"),
                    app = box.getAttribute("data-app"), session = box.getAttribute("data-session"), designer = box.getAttribute("data-designer");
                function esc(s) { return apex.util.escapeHTML(String(s)); }
                function demo(p) { return "f?p=" + app + ":" + (p.pos === "top" ? "DEMO-TOP-NAV" : "DEMO-DASHBOARD") + ":" + session; }
                function look(p) { return "#look=" + encodeURIComponent(p.nav) + "&bar=" + encodeURIComponent(p.bar) + "&pos=" + p.pos + "&st=" + p.state; }
                function full(p) { return "#ns=" + encodeURIComponent(p.nav) + "&nb=" + encodeURIComponent(p.bar) + "&nsx=" + p.state; }
                box.innerHTML = NS_PRESETS.map(function (p) {
                    return '<article class="nvs-Card" data-tags="' + esc(p.tags) + '">' +
                        '<a class="nvs-Card-shot" href="' + esc(designer + look(p)) + '" aria-label="' + esc("Customize " + p.name) + '"><img src="' + esc(files + "gallery/" + p.id + ".jpg") + '" alt="" loading="lazy" width="640" height="400"></a>' +
                        '<div class="nvs-Card-body"><h3 class="nvs-Card-title">' + esc(p.name) + '</h3><span class="nvs-Card-type">' + (p.pos === "top" ? "Top menu" : "Side menu") + (/collapsed/.test(p.tags) ? " - collapsed" : "") + (/flyout/.test(p.tags) ? " - flyout" : "") + '</span>' +
                        '<div class="nvs-Card-actions"><a class="t-Button t-Button--small t-Button--hot" href="' + esc(designer + look(p)) + '"><span class="t-Button-label">Customize</span></a>' +
                        '<a class="t-Button t-Button--small" target="_blank" rel="noopener" href="' + esc(demo(p) + full(p)) + '"><span class="t-Button-label">Full Screen</span></a></div></div></article>';
                }).join("");
                $(document).on("click", ".nvs-Filter button", function () {
                    var f = this.getAttribute("data-f");
                    $(".nvs-Filter button").attr("aria-pressed", "false");
                    this.setAttribute("aria-pressed", "true");
                    $(".nvs-Card").each(function () { this.hidden = !!f && (" " + this.getAttribute("data-tags") + " ").indexOf(" " + f + " ") < 0; });
                });
            })(apex.jQuery);
            ```
    }
    css {
        inline:
            ```css
            .nvs-Hero { padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem); border-radius: 18px; color: #ffffff;
                        background: radial-gradient(circle at 88% 20%, rgba(255,255,255,.16), transparent 40%), linear-gradient(120deg, #1e1b4b, #4338ca 55%, #7c3aed); }
            .nvs-Hero h1 { margin: 0 0 .5rem; font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.1; }
            .nvs-Hero p { max-width: 50rem; margin: 0 0 1.25rem; font-size: 1.0625rem; line-height: 1.6; opacity: .92; }
            .nvs-Hero .t-Button { margin: 0 .5rem .5rem 0; }
            .nvs-Hero .t-Button--hot { --a-button-background-color: #ffffff; --a-button-text-color: #312e81; --a-button-hover-background-color: #e0e7ff; --a-button-hover-text-color: #312e81; }
            .nvs-Hero .nvs-Ghost { --a-button-background-color: transparent; --a-button-text-color: #ffffff; --a-button-hover-background-color: rgba(255,255,255,.14); --a-button-hover-text-color: #ffffff; border: 1px solid rgba(255,255,255,.6); }
            .nvs-Filter { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0 1rem; }
            .nvs-Filter button { padding: .375rem .95rem; border-radius: 999px; border: 1px solid var(--ut-component-border-color, #d0d5dd); background: var(--ut-component-background-color, #fff); color: inherit; font: inherit; font-size: .875rem; cursor: pointer; }
            .nvs-Filter button[aria-pressed="true"] { background: #312e81; border-color: #312e81; color: #ffffff; }
            .nvs-Filter button:focus-visible { outline: 2px solid #4338ca; outline-offset: 2px; }
            .nvs-Grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 1.25rem; }
            .nvs-Card { display: flex; flex-direction: column; overflow: hidden; border-radius: 14px; border: 1px solid var(--ut-component-border-color, #e4e7ec); background: var(--ut-component-background-color, #fff);
                        box-shadow: 0 1px 2px rgba(16,24,40,.05); transition: box-shadow .2s ease, transform .2s ease; }
            .nvs-Card:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -18px rgba(16,24,40,.35); }
            .nvs-Card[hidden] { display: none; }
            .nvs-Card-shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #eef0f4; }
            .nvs-Card-shot img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
            .nvs-Card:hover .nvs-Card-shot img { transform: scale(1.03); }
            .nvs-Card-body { display: flex; flex-direction: column; gap: .5rem; padding: .875rem 1rem 1rem; }
            .nvs-Card-title { margin: 0; font-size: 1rem; font-weight: 700; }
            .nvs-Card-type { align-self: flex-start; padding: .1rem .55rem; border-radius: 999px; background: rgba(67,56,202,.1); color: #3730a3; font-size: .75rem; font-weight: 600; }
            .nvs-Card-actions { display: flex; gap: .5rem; margin-top: .25rem; }
            .nvs-Card-actions .t-Button { flex: 1; justify-content: center; }
            @media (prefers-reduced-motion: reduce) { .nvs-Card, .nvs-Card-shot img { transition: none; } .nvs-Card:hover { transform: none; } .nvs-Card:hover .nvs-Card-shot img { transform: none; } }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Navigation Studio
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="nvs-Hero">
                  <h1>Navigation menus for Oracle APEX</h1>
                  <p>12 designs for the side navigation menu, 6 for the top menu, and a navigation bar that matches them - light and dark, collapsed icon rails, section headings, badges, menu search and a phone bottom bar. Every look is a template option. Pick one, fine-tune it in the Designer, copy the templates into your app.</p>
                  <a class="t-Button t-Button--hot" href="f?p=&APP_ID.:DESIGNER:&APP_SESSION."><span class="t-Button-label">Open the Designer</span></a>
                  <a class="t-Button nvs-Ghost" href="f?p=&APP_ID.:HOW-TO-USE:&APP_SESSION."><span class="t-Button-label">How to use it</span></a>
                </div>
                <div class="nvs-Filter" role="group" aria-label="Filter">
                  <button type="button" data-f="" aria-pressed="true">All</button>
                  <button type="button" data-f="side" aria-pressed="false">Side menu</button>
                  <button type="button" data-f="top" aria-pressed="false">Top menu</button>
                  <button type="button" data-f="light" aria-pressed="false">Light</button>
                  <button type="button" data-f="dark" aria-pressed="false">Dark</button>
                  <button type="button" data-f="collapsed" aria-pressed="false">Collapsed</button>
                  <button type="button" data-f="flyout" aria-pressed="false">Flyout</button>
                </div>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region gallery (
        name: Gallery
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="nvs-Grid" id="nvs-gallery" data-files="#APP_FILES#" data-app="&APP_ID." data-session="&APP_SESSION." data-designer="f?p=&APP_ID.:DESIGNER:&APP_SESSION."></div>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

)
