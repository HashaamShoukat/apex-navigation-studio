    pageItem P2_BAR_STYLE (
        type: selectList
        label {
            label: Navigation Bar Style
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Icons Only;ns-Bar--icons,Pills;ns-Bar--pills,Segmented;ns-Bar--segmented,Outlined;ns-Bar--outline
            nullDisplayValue: Icon and Label
        }
        layout {
            sequence: 90
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_BAR_ACCENT (
        type: selectList
        label {
            label: Navigation Bar Accent
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Ocean;ns-Accent--ocean,Indigo;ns-Accent--indigo,Violet;ns-Accent--violet,Emerald;ns-Accent--emerald,Rose;ns-Accent--rose,Amber;ns-Accent--amber,Slate;ns-Accent--slate,Wine;ns-Accent--wine,Tangerine;ns-Accent--tangerine,Cyan;ns-Accent--cyan
            nullDisplayValue: Match the Menu
        }
        layout {
            sequence: 91
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_BAR_BADGE (
        type: selectList
        label {
            label: Navigation Bar Badges
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Red;ns-Bar--badgeRed,Dot;ns-Bar--badgeDot
            nullDisplayValue: Accent
        }
        layout {
            sequence: 92
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_AVATAR (
        type: switch
        label {
            label: User Avatar
            alignment: left
        }
        layout {
            sequence: 93
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_BAR_SEARCH (
        type: switch
        label {
            label: Search Button
            alignment: left
        }
        layout {
            sequence: 94
            region: @options
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: Y
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_PULSE (
        type: switch
        label {
            label: Pulsing Badges
            alignment: left
        }
        layout {
            sequence: 95
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_DEVICE (
        type: radioGroup
        label {
            label: Preview On
            alignment: left
        }
        settings {
            noOfCols: 3
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Desktop;DESKTOP,Tablet;TABLET,Phone;PHONE
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @preview
            slot: edit
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        default {
            type: static
            staticValue: DESKTOP
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_STATE (
        type: radioGroup
        label {
            label: Menu
            alignment: left
        }
        settings {
            noOfCols: 2
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Expanded;EXPANDED,Collapsed;COLLAPSED
            displayNullValue: false
        }
        layout {
            sequence: 15
            region: @preview
            slot: edit
        }
        appearance {
            template: @/hidden
            templateOptions: [
                #DEFAULT#
                t-Form-fieldContainer--radioButtonGroup
            ]
        }
        default {
            type: static
            staticValue: EXPANDED
        }
        sessionState {
            storage: request
        }
    )

    button open-full (
        buttonName: OPEN_FULL
        label: Open Full Page
        layout {
            sequence: 20
            region: @preview
            slot: edit
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: js-nvd-open
            icon: fa-external-link
        }
        behavior {
            action: definedByDynamicAction
        }
    )

)
